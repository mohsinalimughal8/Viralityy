# =============================================================================
# VIRALITYY — Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# In Railway: add each variable under your service → Variables tab.
# =============================================================================


# =============================================================================
# SECTION 1 — Core infrastructure (required before first deploy)
# =============================================================================

# MongoDB Atlas connection string
# Get from: cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/viralityy?retryWrites=true&w=majority

# JWT secret — generate any 40+ character random string
JWT_SECRET=replace_with_40_plus_random_characters_here

# Session secret — must be different from JWT_SECRET
SESSION_SECRET=replace_with_different_40_plus_random_characters_here

# Your Railway deployment URL
APP_URL=https://viralityy-production.up.railway.app

# Secret for protecting cron endpoints
CRON_SECRET=replace_with_random_string

# Salt for IP address hashing
IP_SALT=replace_with_random_string

# Environment
NODE_ENV=production


# =============================================================================
# SECTION 2 — AI & media (required to run the pipeline)
# =============================================================================

# OpenAI API key — from platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# Google Gemini API key — from aistudio.google.com → Get API key
# Used for voiceover (replaces ElevenLabs — uses your existing Gemini plan)
GEMINI_API_KEY=AIza...

# Optional: override default voice globally (default picks per niche automatically)
# Run --list-voices to see all 30 options. Examples: Kore, Orus, Puck, Umbriel
# GEMINI_VOICE_NAME=Kore

# Where rendered audio WAV files are saved on the server
AUDIO_OUTPUT_DIR=/tmp/viralityy_audio

# Optional CDN prefix for audio file URLs (set when you add S3/Cloudflare R2)
# AUDIO_CDN_BASE_URL=https://cdn.viralityy.com

# Pexels API key for stock footage — from pexels.com/api (free, instant)
PEXELS_API_KEY=...

# YouTube Data API v3 key — from console.cloud.google.com
YOUTUBE_API_KEY=AIza...

# Google OAuth 2.0 for YouTube channel connection
# From console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
YOUTUBE_CLIENT_ID=...apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...
GOOGLE_CALLBACK_URL=https://viralityy-production.up.railway.app/auth/google/callback


# =============================================================================
# SECTION 3 — Stripe billing (add before accepting payments)
# =============================================================================

# Stripe secret key — from dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret — from Stripe → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create 4 products x 2 prices (monthly + annual) in Stripe
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_SHORTS_PRO_MONTHLY=price_...
STRIPE_PRICE_SHORTS_PRO_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...


# =============================================================================
# SECTION 4 — Always-on free features (no env var needed)
# =============================================================================
# These are hardcoded ON in server.js — they cost $0 to run.
# No action needed — active automatically on deploy.
#
# Competitor Watcher     — active (YouTube API free quota + OpenAI)
# Competitor Scraper     — active (YouTube API free quota + OpenAI)
# AI Learning Loop       — active (~$0.02/week OpenAI cost)
# Analytics Collection   — active (YouTube Data API free quota)
# Affiliate Programme    — active (pure MongoDB logic)


# =============================================================================
# SECTION 5 — Shelved features (enable when ready)
# =============================================================================

# Trend Scraper — Reddit + Google Trends + Twitter
# Enable when you have 30+ users
# FEATURE_TREND_SCRAPER=true
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# TWITTER_BEARER_TOKEN=...


# =============================================================================
# SECTION 6 — Optional enhancements
# =============================================================================

# Live web search for Script Research Agent (free tier: 1,000/month)
# TAVILY_API_KEY=...

# Deeper competitor page scraping
# FIRECRAWL_API_KEY=...

# Affiliate payouts via Payoneer (only needed when affiliates request payout)
# PAYONEER_PROGRAM_ID=...
# PAYONEER_API_USERNAME=...
# PAYONEER_API_PASSWORD=...
